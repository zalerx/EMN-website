# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable anon key — safe in the browser; RLS limits it to published articles
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — bypasses RLS. Server-only; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Magic-link email provider (SMTP)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=EMN <noreply@emnunimelb.com>

# Dev-only: bypass auth checks on the membership card page
NEXT_PUBLIC_DEV_BYPASS_AUTH=
